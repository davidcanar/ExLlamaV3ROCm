+/*
+ * Physical odl devices (each is one point-to-point cable to ONE peer).
+ *
+ * NCCL sees ONE virtual net device. NCCL pairs net devices across ranks by
+ * index ("rail 0 with rail 0"), and on a mesh each box's rail 0 is a different
+ * peer, so per-cable devices cannot be exposed directly. Every connection is
+ * negotiated per peer (hello/grant on a per-cable CONTROL stream) and then
+ * carries its own DEDICATED data stream - required because the driver
+ * reassembles received messages with per-stream state, so a stream must have
+ * ONE sender at a time.
+ */
+static int odl_phys[ODL_TB5_MAX_RCCL_DEVICES];
+static int odl_phys_count;
+
+/*
+ * Control plane: one stream per cable carrying ONLY single-frame messages
+ * (single-frame messages need no reassembly, so multiplexing is safe):
+ *
+ *   hello {0x01, S, C}  connector -> acceptor: "I send from dedicated stream
+ *                       S; grant me on my control stream C"
+ *   grant {0x02, S, R}  acceptor -> connector: "deliver to my stream R"
+ */
+#define ODL_CTRL_HELLO 0x01
+#define ODL_CTRL_GRANT 0x02
+
+struct odl_ctrl {
+	odl_tb5_t   handle;
+	int         odl_dev;
+	uint8_t     sid;         /* our control stream on this cable */
+	pthread_t   thread;
