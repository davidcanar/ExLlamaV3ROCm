+/* Sole reader of one cable's control stream: queue hellos for accept(),
+ * publish grants to the connector's comm. */
+static void *ctrl_thread(void *arg)
+{
+	struct odl_ctrl *ct = arg;
+	uint8_t buf[16];
+
+	while (ct->running) {
+		uint8_t src = 0;
+		uint32_t got = 0;
+		int rc = odl_tb5_stream_recv(ct->handle, ct->sid, buf,
+					     sizeof(buf), &src, &got);
+
+		if (rc < 0)
+			break;               /* control stream closed */
+		if (got == 0)
+			continue;
+
+		if (buf[0] == ODL_CTRL_HELLO && got == 4) {
+			pthread_mutex_lock(&ct->lock);
+			if (ct->pending_n < 85) {
+				ct->pending[ct->pending_n * 3] = buf[1];
+				ct->pending[ct->pending_n * 3 + 1] = buf[2];
+				ct->pending[ct->pending_n * 3 + 2] = buf[3];
+				ct->pending_n++;
+			}
+			pthread_mutex_unlock(&ct->lock);
+			DBG(1, "ctrl dev%d: hello S=%u C=%u L=%u queued (%d)",
+			    ct->odl_dev, buf[1], buf[2], buf[3], ct->pending_n);
+		} else if (buf[0] == ODL_CTRL_GRANT) {
+			struct odl_tb5_comm *comm;
+
+			pthread_mutex_lock(&g_lock);
+			comm = g_conn_by_sid[buf[1]];
+			pthread_mutex_unlock(&g_lock);
+			if (comm) {
+				pthread_mutex_lock(&comm->q_lock);
+				comm->dst_id = buf[2];
+				comm->dst_ready = 1;
+				pthread_cond_signal(&comm->q_cond);
+				pthread_mutex_unlock(&comm->q_lock);
+				DBG(1, "ctrl dev%d: grant S=%u -> R=%u",
+				    ct->odl_dev, buf[1], buf[2]);
+			} else {
+				DBG(1, "ctrl dev%d: grant for unknown S=%u",
+				    ct->odl_dev, buf[1]);
+			}
+		}
+	}
+	return NULL;
+}
+
+/* Open one control stream per cable (idempotent; caller holds g_lock). */
+static void odl_ctrl_setup(void)
+{
+	if (g_ctrl_ready)
+		return;
+	odl_scan_devices();
+	for (int i = 0; i < odl_phys_count && g_ctrl_count < ODL_TB5_MAX_RCCL_DEVICES; i++) {
+		int odl = odl_phys[i];
+		odl_tb5_t h;
+		uint8_t sid = 0;
+		struct odl_ctrl *ct = &g_ctrl[g_ctrl_count];
+
+		if (get_shared_handle_locked(odl, &h) != rcclSuccess)
+			continue;
+		if (odl_tb5_stream_open(h, 0, &sid) < 0) {
+			put_shared_handle_locked(odl);
+			continue;
+		}
+		ct->handle = h;
+		ct->odl_dev = odl;
+		ct->sid = sid;
+		ct->running = 1;
+		pthread_mutex_init(&ct->lock, NULL);
+		if (pthread_create(&ct->thread, NULL, ctrl_thread, ct) != 0)
+			ct->running = 0;
+		DBG(1, "ctrl stream: odl dev %d sid %u (peer ip %u.%u.%u.%u)",
+		    odl, sid, (odl_peer_ip_of_dev(odl) >> 24) & 0xff,
+		    (odl_peer_ip_of_dev(odl) >> 16) & 0xff,
+		    (odl_peer_ip_of_dev(odl) >> 8) & 0xff,
+		    odl_peer_ip_of_dev(odl) & 0xff);
+		g_ctrl_count++;
+	}
+	g_ctrl_ready = 1;
+}
+
+/* Our cable index that reaches a peer ip, -1 when unknown. */
+static int odl_ctrl_for_peer(uint32_t peer_ip)
+{
+	int dev = odl_dev_for_peer(peer_ip);
+
+	if (dev < 0)
+		return -1;
+	for (int i = 0; i < g_ctrl_count; i++)
+		if (g_ctrl[i].odl_dev == dev)
+			return i;
+	return -1;
+}
