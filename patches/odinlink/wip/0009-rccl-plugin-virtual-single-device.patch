+/* Peer canonical IP reachable through a given physical odl device, or 0.
+ * This is the inverse of ODL_RCCL_PEERS (peer-ip = local device). */
+static uint32_t odl_peer_ip_of_dev(int odl_dev)
+{
+	const char *s = getenv("ODL_RCCL_PEERS");
+	char buf[512], *save = NULL, *tok;
+
+	if (!s || !*s)
+		return 0;
+	snprintf(buf, sizeof(buf), "%s", s);
+	for (tok = strtok_r(buf, ",", &save); tok;
+	     tok = strtok_r(NULL, ",", &save)) {
+		char *eq = strchr(tok, '=');
+		struct in_addr a;
+
+		if (!eq)
+			continue;
+		*eq = '\0';
+		if (inet_pton(AF_INET, tok, &a) != 1)
+			continue;
+		if (atoi(eq + 1) == odl_dev)
+			return ntohl(a.s_addr);
+	}
+	return 0;
+}
