+/* ── Peer selection for multi-cable hosts ────────────────────────────
+ *
+ * listen() advertises this rank's identity on the link it listens on, so
+ * connect() can pick the local cable that actually reaches that peer instead
+ * of trusting the device index RCCL guessed. Configure with:
+ *
+ *   ODL_RCCL_LOCAL_IP=10.0.2.1                this rank's link address
+ *   ODL_RCCL_PEERS="10.0.2.2=0,10.0.2.3=1"    peer address -> local odl dev
+ *
+ * Both are optional: with neither set the plugin behaves exactly as before
+ * (RCCL's device index is used), so 2-node deployments need no changes.
+ */
+#define ODL_HANDLE_ID_MARK 0xA5   /* marks a handle carrying a peer IPv4 */
+#define ODL_HANDLE_IP_OFF  12     /* after stream_id(1) + "odl_tb5_N\0" */
+
+static uint32_t odl_local_ip(void)
+{
+	const char *s = getenv("ODL_RCCL_LOCAL_IP");
+	struct in_addr a;
+
+	if (!s || !*s)
+		return 0;
+	return inet_pton(AF_INET, s, &a) == 1 ? ntohl(a.s_addr) : 0;
+}
+
+/* Map a peer's advertised IPv4 to the local odl device that reaches it.
+ * Returns -1 when the peer is unknown (caller keeps RCCL's choice). */
+static int odl_dev_for_peer(uint32_t peer_ip)
+{
+	const char *s = getenv("ODL_RCCL_PEERS");
+	char buf[512], *save = NULL, *tok;
+
+	if (!peer_ip || !s || !*s)
+		return -1;
+	snprintf(buf, sizeof(buf), "%s", s);
+
+	for (tok = strtok_r(buf, ",", &save); tok;
+	     tok = strtok_r(NULL, ",", &save)) {
+		char *eq = strchr(tok, '=');
+		struct in_addr a;
+		int dev;
+
+		if (!eq)
+			continue;
+		*eq = '\0';
+		if (inet_pton(AF_INET, tok, &a) != 1)
+			continue;
+		if (ntohl(a.s_addr) != peer_ip)
+			continue;
+		dev = atoi(eq + 1);
+		if (dev >= 0 && dev < ODL_TB5_MAX_RCCL_DEVICES)
+			return dev;
+	}
+	return -1;
+}
