+/* One reader per cable: block for a whole stream message, route by src id. */
+static void *cable_rx_thread(void *arg)
+{
+	struct odl_cable_rx *cb = arg;
+	void *buf = malloc(ODL_RX_MSG_MAX);
+
+	if (!buf)
+		return NULL;
+	while (cb->running) {
+		uint8_t src = 0;
+		uint32_t got = 0;
+		int rc = odl_tb5_stream_recv(cb->handle, cb->sid, buf,
+					     ODL_RX_MSG_MAX, &src, &got);
+
+		if (rc < 0)
+			break;                 /* stream closed / device gone */
+		struct odl_tb5_comm *comm;
+
+		pthread_mutex_lock(&cb->lock);
+		comm = cb->by_src[src];
+		if (comm)
+			comm = comm;          /* refcount-free: comms outlive msg */
+		pthread_mutex_unlock(&cb->lock);
+		if (!comm) {
+			if (got == 1) {          /* connect() hello */
+				pthread_mutex_lock(&cb->lock);
+				int known = 0;
+
+				for (int i = 0; i < cb->pending_n; i++)
+					if (cb->pending[i] == src)
+						known = 1;
+				if (!known && !cb->by_src[src] &&
+				    cb->pending_n < 256)
+					cb->pending[cb->pending_n++] = src;
+				pthread_mutex_unlock(&cb->lock);
+				DBG(1, "cable rx: hello from src=%u queued "
+				     "(pending=%d)", src, cb->pending_n);
+				continue;
+			}
+			DBG(1, "cable rx: no comm for src=%u (len=%u) - dropped",
+			    src, got);
+			continue;
+		}
+		void *copy = malloc(got ? got : 1);
+
+		if (!copy)
+			continue;
+		memcpy(copy, buf, got);
+		comm_deliver(comm, copy, got);
+	}
+	free(buf);
+	return NULL;
+}
+
+/* Append a routed message to the comm's mailbox and wake its worker. */
+static void comm_deliver(struct odl_tb5_comm *comm, void *data, uint32_t len)
+{
+	struct odl_msg *m = malloc(sizeof(*m));
+
+	if (!m) {
+		free(data);
+		return;
+	}
+	m->data = data;
+	m->len = len;
+	m->next = NULL;
+	pthread_mutex_lock(&comm->q_lock);
+	if (comm->mb_tail)
+		comm->mb_tail->next = m;
+	else
+		comm->mb_head = m;
+	comm->mb_tail = m;
+	pthread_cond_signal(&comm->q_cond);
+	pthread_mutex_unlock(&comm->q_lock);
+}
+
+/* Pop one routed message (worker side). NULL when none queued. */
+static struct odl_msg *comm_mb_pop(struct odl_tb5_comm *comm)
+{
+	struct odl_msg *m = comm->mb_head;
+
+	if (!m)
+		return NULL;
+	comm->mb_head = m->next;
+	if (!comm->mb_head)
+		comm->mb_tail = NULL;
+	m->next = NULL;
+	return m;
+}
+
+/*
+ * Receive one message for a comm. On a dispatcher-owned (shared) stream this
+ * pops a routed message from the mailbox; on a dedicated stream it reads the
+ * stream directly. Same contract as odl_tb5_stream_recv: one whole message
+ * per call, buf_len caps what is copied (excess is dropped).
+ */
+static int comm_rx_msg(struct odl_tb5_comm *comm, void *buf, uint32_t buf_len,
+		       uint8_t *src_id, uint32_t *actual)
+{
+	if (!comm->cable)
+		return odl_tb5_stream_recv(comm->handle, comm->stream_id,
+					   buf, buf_len, src_id, actual);
+
+	pthread_mutex_lock(&comm->q_lock);
+	while (!comm->mb_head && !comm->stop)
+		pthread_cond_wait(&comm->q_cond, &comm->q_lock);
+	struct odl_msg *m = comm_mb_pop(comm);
+	pthread_mutex_unlock(&comm->q_lock);
+
+	if (!m)
+		return -ECANCELED;
+	uint32_t n = m->len < buf_len ? m->len : buf_len;
+
+	memcpy(buf, m->data, n);
+	if (src_id)
+		*src_id = comm->peer_sid;
+	if (actual)
+		*actual = n;
+	free(m->data);
+	free(m);
+	return 0;
+}
