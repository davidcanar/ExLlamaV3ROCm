+/*
+ * Per-cable RX dispatcher. The shared listener stream carries traffic for
+ * every connection on that cable; stream messages are atomic and carry the
+ * sender's stream id, so ONE reader per cable can route whole messages to
+ * the connection that owns that sender id. Without it, every recv worker
+ * pulled from the same stream and stole each other's messages.
+ */
+struct odl_cable_rx {
+	odl_tb5_t          handle;
+	int                odl_dev;
+	uint8_t            sid;
+	pthread_t          thread;
+	int                running;
+	pthread_mutex_t    lock;          /* guards by_src[] and pending[] */
+	struct odl_tb5_comm *by_src[256];
+	/* Hello bytes that arrived before their accept(): the dispatcher is
+	 * the SOLE reader of the shared stream, so it queues these instead of
+	 * letting accept() race it for stream data. */
+	uint8_t           pending[256];
+	int                pending_n;
+};
+
+/*
+ * One recv stream per physical cable, opened ONCE per process and shared by
+ * every listen() call.
+ *
+ * Per-listen streams were the bug in the first cut: NCCL calls listen() many
+ * times, each call opened fresh streams (ids 20,21 then 22,23 ...), while a
+ * connect() already in flight kept addressing the ids advertised by an earlier
+ * listener. The hello then landed on a stream the accept() being polled never
+ * looked at, and accept retried forever. A stable set makes the advertised map
+ * identical for every listener, so connect and accept always agree.
