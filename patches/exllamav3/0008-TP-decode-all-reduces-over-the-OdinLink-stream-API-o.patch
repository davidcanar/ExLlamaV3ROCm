index 00000000..e9d9facd
--- /dev/null
+++ b/exllamav3/model/model_tp_odl.py
@@ -0,0 +1,82 @@
+import ctypes
+import os
+import torch
+
+"""
+OdinLink decode all-reduce for the cross-host TP backend (libodl_ar2.so, ~/exl3ds4/odl_ar2).
+
+Two ranks, SUM, fully stream-ordered: the library enqueues [stage into a pinned send slot] ->
+[doorbell] -> [GPU wait + add] on the current stream and a CPU progress thread moves the bytes over
+the OdinLink stream API. Nothing blocks the host, so the backend skips its post-collective sync for
+these ops and the host can queue the following layers while the exchange is in flight.
+
+fp32 tensors travel as bf16 (dtype 3) and come back exactly as the RCCL path rounds them (fp32 ->
+bf16, bf16 sum with fp32 accumulation, -> fp32); EXL3_TP_NCCL_FP32=1 sends fp32 instead. Both ranks
+compute src + peer with commutative IEEE adds, so the reduced tensors stay bit-identical across
+ranks, which the replicated MoE routing relies on.
+
+env: EXL3_TP_ODL_AR2=1 enables it (both ranks), EXL3_TP_ODL_AR2_PEER (rank 1's address, default
+10.0.2.2; rank 1 listens), EXL3_TP_ODL_AR2_PORT (rendezvous, default 29652), EXL3_TP_ODL_AR2_DEV
+(OdinLink device index, default 0), EXL3_TP_ODL_AR2_MAX (largest wire payload in bytes routed here,
+default 64 KiB: the driver's single-ioctl latency path; larger collectives stay on RCCL),
+EXL3_TP_ODL_AR2_LIB (library path).
+"""
+
+_DEFAULT_LIB = os.path.expanduser("~/exl3ds4/odl_ar2/libodl_ar2.so")
+_DT_BF16, _DT_FP16, _DT_FP32, _DT_FP32_BF16WIRE = 0, 1, 2, 3
+
+
+class OdlAllReduce:
+
+    def __init__(self, rank: int, fp32_wire: bool = False):
+        path = os.environ.get("EXL3_TP_ODL_AR2_LIB", _DEFAULT_LIB)
+        lib = ctypes.CDLL(path)
+        lib.odl2_init.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
+        lib.odl2_init.restype = ctypes.c_int
+        lib.odl2_enqueue.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int]
+        lib.odl2_enqueue.restype = ctypes.c_int
+        lib.odl2_last_error.restype = ctypes.c_int
+        lib.odl2_max_bytes.restype = ctypes.c_uint32
+        lib.odl2_shutdown.restype = None
+        peer = os.environ.get("EXL3_TP_ODL_AR2_PEER", "10.0.2.2")
+        port = int(os.environ.get("EXL3_TP_ODL_AR2_PORT", "29652"))
+        dev = int(os.environ.get("EXL3_TP_ODL_AR2_DEV", "0"))
+        if lib.odl2_init(int(rank), dev, peer.encode(), port) != 0:
+            raise RuntimeError(f"odl_ar2: init failed (rank {rank}, peer {peer}:{port}, device {dev})")
+        self.lib = lib
+        self.fp32_wire = fp32_wire
+        self.max_wire = min(int(lib.odl2_max_bytes()), int(os.environ.get("EXL3_TP_ODL_AR2_MAX", str(64 * 1024))))
+        self.ops = 0
+
+    def _dtype(self, t: torch.Tensor):
+        if t.dtype == torch.float32:
+            return (_DT_FP32, 4) if self.fp32_wire else (_DT_FP32_BF16WIRE, 2)
+        if t.dtype == torch.bfloat16:
+            return _DT_BF16, 2
+        if t.dtype == torch.float16:
+            return _DT_FP16, 2
+        return None, 0
+
+    def try_all_reduce_(self, t: torch.Tensor) -> bool:
+        """In-place SUM all-reduce of t when it fits the latency path; False = caller uses RCCL.
+        Both ranks see the same shapes in the same order, so they always take the same route."""
+        if not (t.is_cuda and t.is_contiguous()):
+            return False
+        code, wire_elt = self._dtype(t)
+        if code is None or t.numel() * wire_elt > self.max_wire:
+            return False
+        if self.lib.odl2_last_error():
+            raise RuntimeError("odl_ar2: transport error latched by a previous all-reduce "
+                               "(peer gone or link down); restart both ranks")
+        stream = torch.cuda.current_stream(t.device).cuda_stream
+        rc = self.lib.odl2_enqueue(ctypes.c_void_p(stream), ctypes.c_void_p(t.data_ptr()),
+                                   ctypes.c_void_p(t.data_ptr()), t.numel() * t.element_size(), code)
+        if rc != 0:
+            raise RuntimeError(f"odl_ar2: enqueue failed ({rc})")
+        self.ops += 1
+        return True
+
+    def close(self):
+        if self.lib is not None:
+            self.lib.odl2_shutdown()
+            self.lib = None
