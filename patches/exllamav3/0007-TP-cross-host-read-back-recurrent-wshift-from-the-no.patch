diff --git a/tests/tp/test_tp_wshift_readback.py b/tests/tp/test_tp_wshift_readback.py
new file mode 100644
index 00000000..b1e98ad0
--- /dev/null
+++ b/tests/tp/test_tp_wshift_readback.py
@@ -0,0 +1,234 @@
+"""Cross-host recurrent wshift readback.
+
+On a cross-host non-output rank the forward/prefill pass runs on a real child worker against a
+pickled copy of the exported recurrent states; the ring shifts (wshift) the walk writes there
+used to be lost, so the driver's DSV4/SWA states never advanced window_beg and the ring
+addressing went stale once position outgrew the ring (~750 tokens on DS4.1). These tests pin
+the fix: the worker returns its wshifts as the pass result, and forward_tp()/prefill_tp() on a
+non-output cross-host driver fetch that result synchronously and copy the shifts onto the
+driver's exports before restore_tp_params() hands them to the real states. Output-rank,
+single-host, warmup and single-module paths must stay exactly as they were.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from exllamav3.model import model_tp_fn
+from exllamav3.model.model_tp import Model_TPMixin
+from exllamav3.model.model_tp_backend import TPBackendNull
+from exllamav3.model.model_tp_fn import mp_model_forward, recurrent_wshift_readback
+
+pytestmark = pytest.mark.nogpu
+
+
+# ---- fakes -----------------------------------------------------------------------------------------------------------
+
+
+class FakeWalkModule:
+    """Stand-in for an imported TP module shard: writes a fixed wshift into every exported
+    recurrent state it sees, the way the DSA ring update does."""
+    key = "fake"
+    caps = {}
+
+    def __init__(self, shift: int = 0):
+        self.shift = shift
+
+    def prefetch(self, x, params):
+        pass
+
+    def prepare_for_device(self, x, params):
+        return x
+
+    def forward(self, x, params):
+        for rs in params.get("recurrent_states") or []:
+            if rs is not None:
+                rs.wshift = self.shift
+        return x
+
+
+class FakeConsumer:
+    def recv(self, p, cuda: bool = False):
+        return p
+
+
+def child_context(rank: int, output_rank: int, cross_host: bool, modules) -> dict:
+    return {
+        "device": 0,
+        "rank": rank,
+        "output_rank": output_rank,
+        "cross_host": cross_host,
+        "modules": modules,
+        "inf_consumer": FakeConsumer(),
+        "backend": TPBackendNull(),
+    }
+
+
+def exported(wshift: int = 0) -> SimpleNamespace:
+    return SimpleNamespace(cache = 1, slot = 0, position = 0, window_beg = 0, wshift = wshift)
+
+
+class FakeState:
+    """Real-state stand-in: exports a plain handle, readback copies the handle's wshift."""
+    def __init__(self):
+        self.wshift = 0
+        self.readback = None
+
+    def tp_export(self):
+        return exported()
+
+    def tp_readback(self, exp):
+        self.readback = exp.wshift
+
+
+class FakeProducer:
+    def clear(self):
+        pass
+
+    def send(self, x):
+        return x
+
+
+class FakePipe:
+    def __init__(self):
+        self.sent = []
+
+    def send_bytes(self, msg):
+        self.sent.append(msg)
+
+
+class FakeDriver(Model_TPMixin):
+    """Just enough of the TP driver to run the real forward_tp/prefill_tp bodies: dispatch and
+    result plumbing are recorded instead of touching processes or CUDA."""
+    def __init__(self, *, cross_host: bool, rank: int, output_device: int, active_devices):
+        Model_TPMixin.__init__(self)
+        self.tp_cross_host = cross_host
+        self.tp_rank = rank
+        self.tp_output_device = output_device
+        self.active_devices = active_devices
+        self.mp_parent_conn = {d: FakePipe() for d in active_devices if d != output_device or cross_host}
+        self.tp_producer = FakeProducer()
+        self.results = {}
+        self.dispatched = []
+
+    def tp_worker_dispatch(self, device, fn, args):
+        self.dispatched.append((device, fn))
+
+    def tp_worker_result(self, device):
+        return self.results.pop(device)
+
+
+# ---- worker side: the pass result carries the wshifts ---------------------------------------------------------------
+
+
+def test_readback_helper_collects_wshifts_and_nones():
+    params = {"recurrent_states": [exported(256), None, exported(0)]}
+    assert recurrent_wshift_readback(params) == [256, None, 0]
+    assert recurrent_wshift_readback({}) == []
+
+
+def test_forward_returns_wshifts_on_cross_host_non_output_rank():
+    exp = exported()
+    params = {"recurrent_states": [exp]}
+    ctx = child_context(rank = 1, output_rank = 0, cross_host = True, modules = [FakeWalkModule(shift = 256)])
+    x = torch.zeros(1, 1, 4)
+    out = mp_model_forward(ctx, x, params, last_kv_module_idx = 99, prefill = False, single_idx = None)
+    assert out == {"recurrent_wshifts": [256]}
+    assert exp.wshift == 256
+
+
+def test_prefill_stop_returns_wshifts_on_cross_host_non_output_rank():
+    exp = exported()
+    params = {"recurrent_states": [exp]}
+    modules = [FakeWalkModule(shift = 512), FakeWalkModule(shift = 512), FakeWalkModule(shift = 512)]
+    ctx = child_context(rank = 1, output_rank = 0, cross_host = True, modules = modules)
+    out = mp_model_forward(ctx, torch.zeros(1, 1, 4), params, last_kv_module_idx = 1, prefill = True, single_idx = None)
+    assert out == {"recurrent_wshifts": [512]}
+    assert "prefill" not in params
+
+
+def test_output_rank_and_single_host_and_warmup_paths_unchanged():
+    x = torch.zeros(1, 1, 4)
+    # single-host child
+    ctx = child_context(rank = 1, output_rank = 1, cross_host = False, modules = [FakeWalkModule(shift = 256)])
+    assert mp_model_forward(ctx, x, {"recurrent_states": [exported()]}, 99, False, None) is x
+    # cross-host output rank (the pseudo worker in the driver's process)
+    ctx = child_context(rank = 0, output_rank = 0, cross_host = True, modules = [FakeWalkModule(shift = 256)])
+    assert mp_model_forward(ctx, x, {"recurrent_states": [exported()]}, 99, False, None) is x
+    # warmup, cross-host non-output
+    ctx = child_context(rank = 1, output_rank = 0, cross_host = True, modules = [FakeWalkModule(shift = 256)])
+    assert mp_model_forward(ctx, x, {"tp_warmup": True, "recurrent_states": [exported()]}, 99, False, None) is x
+    # single-module walk
+    assert mp_model_forward(ctx, x, {"recurrent_states": [exported()]}, 99, False, 0) is x
+
+
+# ---- driver side: forward_tp / prefill_tp apply the local worker's wshifts ------------------------------------------
+
+
+def run_forward(driver: Model_TPMixin, params: dict, prefill: bool):
+    x = torch.zeros(1, 1, 4)
+    if prefill:
+        return driver.prefill_tp(x, params, 99, [])
+    return driver.forward_tp(x, params, 99, [])
+
+
+@pytest.mark.parametrize("prefill", [False, True])
+def test_non_output_cross_host_driver_applies_local_wshifts(prefill):
+    driver = FakeDriver(cross_host = True, rank = 1, output_device = 0, active_devices = [0, 1])
+    orig = FakeState()
+    params = {"recurrent_states": [orig]}
+    # what the real child worker on this host would answer: the pass result of mp_model_forward
+    child_ctx = child_context(1, 0, True, [FakeWalkModule(shift = 768)])
+    child_params = {"recurrent_states": [orig.tp_export()]}
+    driver.results[1] = mp_model_forward(child_ctx, torch.zeros(1, 1, 4), child_params, 99, prefill, None)
+
+    out = run_forward(driver, params, prefill)
+    assert out is None
+    assert orig.readback == 768                    # reached the real state through tp_readback
+    assert params["recurrent_states"] == [orig]    # originals restored
+    assert driver.tp_pending_acks == [-1]          # local rank's ack consumed, CPU helper's left deferred
+    assert 1 not in driver.results                 # nothing left to drain for the local rank
+
+
+def test_non_output_cross_host_driver_requires_the_readback_frame():
+    driver = FakeDriver(cross_host = True, rank = 1, output_device = 0, active_devices = [0, 1])
+    driver.results[1] = None                       # a stale/None ack would mean lost wshifts
+    with pytest.raises(AssertionError):
+        run_forward(driver, {"recurrent_states": [FakeState()]}, prefill = False)
+
+
+def test_output_rank_and_single_host_drivers_defer_as_before():
+    # cross-host output rank: result comes from the inline pseudo worker, readback path untouched
+    driver = FakeDriver(cross_host = True, rank = 0, output_device = 0, active_devices = [0, 1])
+    logits = torch.zeros(1, 1, 8)
+    driver.results[0] = logits
+    orig = FakeState()
+    out = run_forward(driver, {"recurrent_states": [orig]}, prefill = False)
+    assert out is logits
+    assert orig.readback == 0                     # export untouched (no remote worker applied anything)
+    assert driver.tp_pending_acks == [-1]         # rank 1 is remote on cross-host: only the CPU helper defers
+
+    # single-host driver: child acks stay deferred, nothing is fetched synchronously
+    driver = FakeDriver(cross_host = False, rank = 0, output_device = 0, active_devices = [0, 1])
+    driver.results[0] = logits
+    driver.results[1] = None
+    orig = FakeState()
+    out = run_forward(driver, {"recurrent_states": [orig]}, prefill = False)
+    assert out is logits
+    assert orig.readback == 0
+    assert driver.tp_pending_acks == [1, -1]
+    assert 1 in driver.results
+
+
+def test_warmup_pass_on_non_output_rank_stays_deferred():
+    driver = FakeDriver(cross_host = True, rank = 1, output_device = 0, active_devices = [0, 1])
+    driver.results[1] = None
+    orig = FakeState()
+    x = torch.zeros(1, 1, 4)
+    out = driver.forward_tp(x, {"tp_warmup": True, "recurrent_states": [orig]}, 99, [])
+    assert out is None
+    assert orig.readback == 0                      # warmup export untouched
+    assert driver.tp_pending_acks == [1]           # no CPU helper dispatch on warmup, ack still deferred
+    assert 1 in driver.results
+    assert all(dev != -1 for dev, _ in driver.dispatched)
-- 
