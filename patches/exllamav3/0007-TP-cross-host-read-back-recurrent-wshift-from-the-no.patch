+def recurrent_wshift_readback(params: dict) -> list:
+    """Ring shifts (wshift) this worker's copy of the exported recurrent states accumulated
+    during a forward pass. On a cross-host non-output rank the pass runs on a real child
+    worker against its own pickled exports, so the shifts it writes are invisible to the
+    driver's copies; forward_tp()/prefill_tp() read this list back through the pipe and copy
+    it onto the driver's exports before restore_tp_params() transfers it to the real states.
+    The output rank needs none of this: its pseudo worker shares the driver's exports."""
+    rs = params.get("recurrent_states")
+    if not rs:
+        return []
+    return [getattr(r, "wshift", None) if r is not None else None for r in rs]
+
+
+def _wshift_readback_result(local_context: dict, params: dict, warmup: bool, single_idx) -> dict | None:
+    """Result frame a cross-host non-output worker returns instead of the (always None) residual:
+    the recurrent wshift metadata its driver must apply. None everywhere else (output rank,
+    single-host children, warmup, single-module walks) keeps those paths byte for byte as they
+    were."""
+    if (warmup or single_idx is not None
+            or not local_context.get("cross_host")
+            or local_context["rank"] == local_context["output_rank"]):
+        return None
+    return {"recurrent_wshifts": recurrent_wshift_readback(params)}
+
+
 def mp_model_forward(
     local_context: dict,
     shared_input: dict,
@@ -314,10 +339,11 @@ def mp_model_forward(
         if prefill and idx == last_kv_module_idx:
             backend.end_cpu_reduce_jobs()
             del params["prefill"]
-            return None
