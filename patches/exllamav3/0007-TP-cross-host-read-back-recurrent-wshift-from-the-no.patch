+    def tp_apply_local_wshifts(self, params: dict, warmup: bool = False):
+        """Cross-host, non-output rank only: fetch this host's worker result for the pass that
+        just ran and copy its recurrent wshift metadata onto the driver's exported states.
+
+        The DSV4/SWA ring shift a pass decides is written into the exported recurrent-state
+        handle the walk sees. On the output rank that handle is the driver's own object (the
+        pseudo worker shares this process), so restore_tp_params() already transfers the shift.
+        A non-output cross-host rank instead walked on a real child worker holding a pickled
+        copy, and without this readback the shift was lost -- window_beg never advanced, and the
+        ring addressing went stale once position outgrew the ring (~750 tokens on DS4.1), which
+        is why cross-host serving was capped there.
+
+        The result is tiny (a list of ints) and consumed synchronously, so the local rank's ack
+        never joins the deferred tp_pending_acks; the output rank's exports are untouched (the
+        pseudo worker already mutated them), and single-host drivers never enter this path.
+        restore_tp_params() then moves the shift onto the real states, and the caller's
+        advance_recurrent_states()/post_advance() applies it to window_beg."""
+        if warmup or not self.tp_cross_host or self.tp_rank == self.tp_output_device:
+            return
+        payload = self.tp_worker_result(self.tp_rank)
+        assert isinstance(payload, dict) and "recurrent_wshifts" in payload, "TP logic error"
+        if self.tp_rank in self.tp_pending_acks:
+            self.tp_pending_acks.remove(self.tp_rank)
+        exported_rs = params.get("recurrent_states")
+        if exported_rs is not None:
+            for exp, wshift in zip(exported_rs, payload["recurrent_wshifts"]):
+                if exp is not None and wshift is not None and hasattr(exp, "wshift"):
+                    exp.wshift = wshift
+
+
     def prefill_tp(
