--- /dev/null
+++ b/tests/tp/test_tp_rank_identity.py
@@ -0,0 +1,90 @@
+"""Cross-host workers use global TP ranks for plans and local CUDA ordinals for allocation."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from exllamav3.model import model_tp_fn
+from exllamav3.modules.hyperconnections import GatedResidual
+
+pytestmark = pytest.mark.nogpu
+
+
+class FakeImportedModule:
+    caps = {}
+    key = "fake"
+
+    def all_cache_modules(self):
+        return []
+
+    def all_recurrent_modules(self):
+        return []
+
+
+def append_context(device, rank, cross_host):
+    return {
+        "device": device,
+        "rank": rank,
+        "cross_host": cross_host,
+        "modules": [],
+        "kv_modules": [],
+        "recurrent_modules": [],
+        "plan": [
+            {"fake": (0, 2, "channels")},
+            {"fake": (2, 5, "channels")},
+            {"fake": (5, 9, "channels")},
+        ],
+    }
+
+
+def test_cross_host_append_uses_rank_plan(monkeypatch):
+    monkeypatch.setattr(GatedResidual, "link_sites", lambda modules: None)
+    context = append_context(device=0, rank=1, cross_host=True)
+    received = []
+
+    class FakeExport:
+        @classmethod
+        def tp_import(cls, local_context, exported, plan):
+            received.append((local_context["device"], plan))
+            return FakeImportedModule()
+
+    model_tp_fn.mp_model_append(context, {"cls": FakeExport})
+    assert received == [(0, {"fake": (2, 5, "channels")})]
+
+
+def test_single_host_append_keeps_cuda_plan_index(monkeypatch):
+    monkeypatch.setattr(GatedResidual, "link_sites", lambda modules: None)
+    context = append_context(device=2, rank=0, cross_host=False)
+    received = []
+
+    class FakeExport:
+        @classmethod
+        def tp_import(cls, local_context, exported, plan):
+            received.append((local_context["device"], plan))
+            return FakeImportedModule()
+
+    model_tp_fn.mp_model_append(context, {"cls": FakeExport})
+    assert received == [(2, {"fake": (5, 9, "channels")})]
+
+
+def test_cross_host_output_gather_uses_rank_identity():
+    context = {
+        "device": 0,
+        "rank": 1,
+        "cross_host": True,
+        "modules": [SimpleNamespace(key="head")],
+        "plan": [
+            {"head": (0, 4, "vocab")},
+            {"head": (4, 8, "vocab")},
+        ],
+        "active_devices": [0, 1],
+        "output_device": 0,
+    }
+
+    model_tp_fn.mp_model_append_gather(context)
+    gather = context["modules"][-1]
+    assert gather.device == 1
+    assert gather.output_device == 0
+    assert gather.gather_devices == [0, 1]
+    assert gather.ldims == [4, 4]
+    assert gather.active
